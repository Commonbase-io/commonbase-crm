# Supabase project (local: `supabase start` prints these).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Bypasses RLS: callers must authorize explicitly.
SUPABASE_SERVICE_ROLE_KEY=

# Apollo live mode stays off until written approval from Apollo is on file
# (see docs/apollo-integration-gates.md). Any value other than "approved" keeps it off.
APOLLO_LIVE_GATE=locked

# Database URL used by `npm run test:db` (needs CREATEDB). Defaults to the local socket.
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/postgres
