# Local and CI placeholders only. Replace every value outside this repo before production.
# The running app connects as crm_app, a non-superuser role with NOBYPASSRLS.
# Migrations use DATABASE_URL_MIGRATE (a role that can own objects). Never point DATABASE_URL at a superuser.
DATABASE_URL=postgresql://crm_app:crm_app_local_only@localhost:5432/crm
DATABASE_URL_MIGRATE=postgresql://postgres:postgres@localhost:5432/crm
